# ==============================================================================
# AlgoAtlas Client Environment Configuration
# ==============================================================================

# Backend API URL
# - Local development: http://localhost:5001
# - Production on Vercel: Set this in Vercel Project Settings > Environment Variables
#   e.g. https://your-backend-app.onrender.com (without trailing slash)
VITE_API_URL=http://localhost:5001

# Google OAuth 2.0 Web Client ID
# - Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# - IMPORTANT: In the Google Console, add both your local URLs (http://localhost:5173, http://localhost:3000)
#   AND your production Vercel URL (https://your-app.vercel.app) under "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID= 
