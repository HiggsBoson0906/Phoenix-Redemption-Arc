# ==============================================================================
# AlgoAtlas Server Environment Configuration
# ==============================================================================

# Server Port (Render sets process.env.PORT automatically)
PORT=5001

# Environment mode ('development' or 'production')
NODE_ENV=development

# MongoDB Atlas Connection URI
# e.g. mongodb+srv://<username>:<password>@<cluster>.mongodb.net/algoatlas?retryWrites=true&w=majority
# IMPORTANT: In MongoDB Atlas > Network Access, ensure 0.0.0.0/0 is whitelisted so Render can connect.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/algoatlas?retryWrites=true&w=majority

# Secret key used for signing & verifying AlgoAtlas JWT authentication tokens
# Generate any long random string (e.g. openssl rand -base64 32)
JWT_SECRET=your_long_random_jwt_secret_key_here

# Frontend Application URL(s) for CORS whitelist
# - Supports comma-separated origins for local + production:
#   e.g. http://localhost:5173,http://localhost:3000,https://your-algoatlas-app.vercel.app
CLIENT_URL=http://localhost:5173,http://localhost:3000,https://your-algoatlas-app.vercel.app

# Google OAuth 2.0 Credentials
# - GOOGLE_CLIENT_ID must match VITE_GOOGLE_CLIENT_ID from the frontend client.
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
